# Copy to .env and fill in. On Vercel these are set as project environment variables.
PORT=4000
NODE_ENV=development
TZ=Africa/Kampala

# PostgreSQL. Either a full connection string (Neon provides DATABASE_URL) ...
# DATABASE_URL=postgresql://user:password@host/vangy_wine?sslmode=require
# ... or separate settings for a PostgreSQL server on this computer:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=vangy_wine

# Long random string used to sign login tokens (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Web app address(es) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# The director's login. Created by the migrations when these are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Vangy Director
