# Copy to .env and fill in. On Railway set these as service variables.
PORT=4000
NODE_ENV=development
TZ=Africa/Kampala

# Either a full URL (Railway provides MYSQL_URL) ...
# DATABASE_URL=mysql://user:password@host:3306/vangy_wine
# ... or separate settings:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vangy_wine

# Long random string used to sign login tokens (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Web app address(es) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# The director's login. Created by the migrations when these are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Vangy Director
